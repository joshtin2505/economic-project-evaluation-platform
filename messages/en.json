  "formulas": {
    "vpn": "NPV = \\sum_{t=0}^{n} \\frac{CF_t}{(1+i)^t}",
    "tir": "0 = \\sum_{t=0}^{n} \\frac{CF_t}{(1+IRR)^t}",
    "bc": "B/C = \\frac{\\sum PV_{Benefits}}{\\sum PV_{Costs}}",
    "newtonRaphson": "r_{n+1} = r_n - \\frac{NPV(r_n)}{NPV'(r_n)}",
    "capm": "MARR = R_f + \\beta(R_m - R_f)",
    "wacc": "WACC = w_e \\cdot k_e + w_d \\cdot k_d \\cdot (1-T)"
  }
